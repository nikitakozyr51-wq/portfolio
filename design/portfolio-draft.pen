                                        {
                                          "id": "news--beyond-the-screen-390-n24",
                                          "type": "text",
                                          "name": "At Sonori, this concept shapes not only motion and identity ",
                                          "content": "At Sonori, this concept shapes not only motion and identity work but also the philosophy behind design itself. The studio experiments with modular systems that generate thousands of unique compositions within a unified visual language. The process feels closer to gardening than design: you plant parameters, nurture growth, and watch unpredictable beauty emerge.",
                                          "x": 0,
                                          "y": 1,
                                          "width": 362.797,
                                          "height": 105,
                                          "textGrowth": "fixed-width-height",
