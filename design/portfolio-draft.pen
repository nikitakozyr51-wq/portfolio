                                      "children": [
                                        {
                                          "id": "news--beyond-the-screen-390-n38",
                                          "type": "text",
                                          "name": "Designers now act as emotional translators, shaping technolo",
                                          "content": "Designers now act as emotional translators, shaping technology that speaks softly rather than shouts. The goal is not to impress but to align — to make the digital experience feel like a conversation, not an instruction.",
                                          "x": 0,
                                          "y": 1,
                                          "width": 367.328,
                                          "height": 69,
                                          "textGrowth": "fixed-width-height",
