                                      "children": [
                                        {
                                          "id": "news--architecture-in-motion-390-n22",
                                          "type": "text",
                                          "name": "Generative design represents one of the most radical shifts ",
                                          "content": "Generative design represents one of the most radical shifts in modern creativity. Instead of fixed compositions, designers now create systems capable of inventing their own solutions. Algorithms evolve visuals through logic, randomness, and adaptation — creating patterns beyond human imagination.",
                                          "x": 0,
                                          "y": 1,
                                          "width": 369.297,
                                          "height": 87,
