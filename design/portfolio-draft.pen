                                      "children": [
                                        {
                                          "id": "news--human-machines-1440-n48",
                                          "type": "text",
                                          "name": "Technology once stood behind design — invisible, mechanical,",
                                          "content": "Technology once stood behind design — invisible, mechanical, and silent. Today, it’s the material itself. The new generation of designers treats algorithms like clay, sensors like brushes, and data as pigment. The result is an aesthetic born not from surfaces but from behavior.",
                                          "x": 0,
                                          "y": 2,
                                          "width": 535.359,
                                          "height": 80,
