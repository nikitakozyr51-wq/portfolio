                                      "children": [
                                        {
                                          "id": "works--rik-showreels-1440-n39",
                                          "type": "text",
                                          "name": "I created two showreels for RIK Animation, one at the end of",
                                          "content": "I created two showreels for RIK Animation, one at the end of 2024 and another in 2025. Each was designed around a different visual approach to presenting the studio’s work.",
                                          "x": 0,
                                          "y": 0,
                                          "width": 646.859,
                                          "height": 38,
                                          "textGrowth": "fixed-width-height",
