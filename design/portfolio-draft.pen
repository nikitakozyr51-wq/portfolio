                                        {
                                          "id": "news--generative-design-390-n26",
                                          "type": "text",
                                          "name": "As the digital extends beyond the monitor, presence becomes ",
                                          "content": "As the digital extends beyond the monitor, presence becomes the new currency of design. The goal is no longer visibility — it’s immersion.",
                                          "x": 0,
                                          "y": 1,
                                          "width": 364.766,
                                          "height": 33,
