                                      "children": [
                                        {
                                          "id": "news--generative-design-1440-n47",
                                          "type": "text",
                                          "name": "The digital architect works with timing instead of concrete,",
                                          "content": "The digital architect works with timing instead of concrete, with opacity instead of shadow. Each transition serves as a corridor, every page a new chamber defined by light and motion. This approach redefines how users inhabit a website — not as visitors but as participants in a constructed atmosphere.",
                                          "x": 0,
                                          "y": 2,
                                          "width": 555.891,
                                          "height": 80,
