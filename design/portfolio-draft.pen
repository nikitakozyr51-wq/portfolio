                                      "children": [
                                        {
                                          "id": "news--the-aesthetics-of-technology-1440-n35",
                                          "type": "text",
                                          "name": "This collaboration between man and machine opens philosophic",
                                          "content": "This collaboration between man and machine opens philosophical questions: where does authorship end, and where does curation begin? The answer may lie in emotion. While AI can generate patterns, only humans can assign meaning. The art of the near future will be defined by emotional programming — the translation of empathy into algorithmic form.",
                                          "x": 0,
                                          "y": 2,
                                          "width": 544.797,
                                          "height": 80,
                                          "textGrowth": "fixed-width-height",
