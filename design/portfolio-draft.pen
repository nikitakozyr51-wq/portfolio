                                        {
                                          "id": "news--the-aesthetics-of-technology-390-n41",
                                          "type": "text",
                                          "name": "By merging motion and structure, designers now build emotion",
                                          "content": "By merging motion and structure, designers now build emotional spaces that breathe, shift, and react. The result is architecture without gravity — a poetic convergence of interaction, perception, and time.",
                                          "x": 0,
                                          "y": 1,
                                          "width": 364.828,
