                                      "children": [
                                        {
                                          "id": "news--beyond-the-screen-390-n36",
                                          "type": "text",
                                          "name": "Instead of directing users, emotional interfaces anticipate ",
                                          "content": "Instead of directing users, emotional interfaces anticipate them. Micro-interactions mirror human gestures: hover delays resemble hesitation, gradients fade like breathing, transitions echo the natural rhythm of attention. This approach transforms utility into connection.",
                                          "x": 0,
                                          "y": 1,
                                          "width": 364.609,
                                          "height": 69,
                                          "textGrowth": "fixed-width-height",
                                          "fill": "#000000",
